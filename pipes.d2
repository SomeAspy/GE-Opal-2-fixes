vars: {
  d2-config: {
    theme-id: 200
  }
}
direction: right
title: Flow of water &\npiping diagram {
  shape: text
  near: top-center
  style: {
    font-size: 55
  }
}

* {
  style: {
    font-size: 30
  }
}

external tank -> internal tank (lower)
internal tank (lower) -> pump
pump -> enclosed tank
enclosed tank -> T junction
T junction -> drain hose
T junction -> ice maker

ice maker -> ice melting -> internal tank (lower) {
  style: {
    stroke-dash: 3
  }
}
